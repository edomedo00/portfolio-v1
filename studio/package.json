{
  "name": "@portfolio-v1/studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity Studio for Portfolio v1.",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "lint": "eslint .",
    "start": "sanity start",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --force && sanity typegen generate"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^6.9.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.9.2",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
